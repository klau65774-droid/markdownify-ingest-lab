  "components": {
    "schemas": {
      "AuditCheck": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "deep_dom_nesting",
              "oversized_html_bytes",
              "quadratic_ordered_list",
              "credential_redaction"
            ],
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ],
            "title": "Status"
          },
          "elapsed_us": {
            "type": "integer",
            "title": "Elapsed Us"
          },
          "details": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "elapsed_us",
          "details"
        ],
        "title": "AuditCheck"
      },
      "AuditResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ],
            "title": "Status"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/AuditCheck"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "AuditResult"
      },
      "BaselineResult": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "commit": {
            "type": "string",
            "title": "Commit"
          },
          "markdown": {
            "type": "string",
            "title": "Markdown"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "leaked_threat_count": {
            "type": "integer",
            "title": "Leaked Threat Count"
          },
          "leaked_threats": {
            "items": {
              "$ref": "#/components/schemas/ThreatFinding"
            },
            "type": "array",
            "title": "Leaked Threats"
          },
          "table_alignment_valid": {
            "type": "boolean",
            "title": "Table Alignment Valid"
          },
          "elapsed_us": {
            "type": "integer",
            "title": "Elapsed Us"
          }
        },
        "type": "object",
        "required": [
          "version",
          "commit",
          "markdown",
          "token_count",
          "leaked_threat_count",
          "leaked_threats",
          "table_alignment_valid",
          "elapsed_us"
        ],
        "title": "BaselineResult"
      },
      "BatchDocInput": {
        "properties": {
          "html": {
            "type": "string",
            "title": "Html"
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "html"
        ],
        "title": "BatchDocInput"
      },
      "BatchDocSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "upstream_token_count": {
            "type": "integer",
            "title": "Upstream Token Count"
          },
          "token_reduction_rate": {
            "type": "number",
            "title": "Token Reduction Rate"
          },
          "threats_detected": {
            "type": "integer",
            "title": "Threats Detected"
          },
          "threats_cleaned": {
            "type": "integer",
            "title": "Threats Cleaned"
          },
          "threats_blocked": {
            "type": "integer",
            "title": "Threats Blocked"
          },
          "table_alignment_valid": {
            "type": "boolean",
            "title": "Table Alignment Valid"
          },
          "markdown_preview": {
            "type": "string",
            "title": "Markdown Preview"
          },
          "elapsed_us": {
            "type": "integer",
            "title": "Elapsed Us"
          }
        },
        "type": "object",
        "required": [
          "id",
          "token_count",
          "upstream_token_count",
          "token_reduction_rate",
          "threats_detected",
          "threats_cleaned",
          "threats_blocked",
          "table_alignment_valid",
          "markdown_preview",
          "elapsed_us"
        ],
        "title": "BatchDocSummary"
      },
      "BatchPreviewRequest": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/BatchDocInput"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Documents"
          },
          "policy": {
            "type": "string",
            "enum": [
              "raw_upstream",
              "clean_rag",
              "strict_guard"
            ],
            "title": "Policy",
            "default": "strict_guard"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "BatchPreviewRequest"
      },
      "BatchPreviewResult": {
        "properties": {
          "document_count": {
            "type": "integer",
            "title": "Document Count"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "upstream_token_count": {
            "type": "integer",
            "title": "Upstream Token Count"
          },
          "token_reduction_rate": {
            "type": "number",
            "title": "Token Reduction Rate"
          },
          "threats_detected": {
            "type": "integer",
            "title": "Threats Detected"
          },
          "threats_cleaned": {
            "type": "integer",
            "title": "Threats Cleaned"
          },
          "threats_blocked": {
            "type": "integer",
            "title": "Threats Blocked"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/BatchDocSummary"
            },
            "type": "array",
            "title": "Documents"
          }
        },
        "type": "object",
        "required": [
          "document_count",
          "token_count",
          "upstream_token_count",
          "token_reduction_rate",
          "threats_detected",
          "threats_cleaned",
          "threats_blocked",
          "documents"
        ],
        "title": "BatchPreviewResult"
      },
      "BenchmarkMetrics": {
        "properties": {
          "case_count": {
            "type": "integer",
            "title": "Case Count"
          },
          "injection_count": {
            "type": "integer",
            "title": "Injection Count"
          },
          "table_case_count": {
            "type": "integer",
            "title": "Table Case Count"
          },
          "injection_block_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Injection Block Rate"
          },
          "content_f1": {
            "type": "number",
            "title": "Content F1"
          },
          "token_reduction_rate": {
            "type": "number",
            "title": "Token Reduction Rate"
          },
          "table_alignment_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Table Alignment Rate"
          },
          "p95_us": {
            "type": "integer",
            "title": "P95 Us"
          },
          "p99_us": {
            "type": "integer",
            "title": "P99 Us"
          }
        },
        "type": "object",
        "required": [
          "case_count",
          "injection_count",
          "table_case_count",
          "injection_block_rate",
          "content_f1",
          "token_reduction_rate",
          "table_alignment_rate",
          "p95_us",
          "p99_us"
        ],
        "title": "BenchmarkMetrics"
      },
      "BenchmarkResult": {
        "properties": {
          "case_count": {
            "type": "integer",
            "title": "Case Count"
          },
          "modes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/BenchmarkMetrics"
            },
            "propertyNames": {
              "enum": [
                "raw_upstream",
                "clean_rag",
                "strict_guard"
              ]
            },
            "type": "object",
            "title": "Modes"
          },
          "by_category": {
            "additionalProperties": {
              "additionalProperties": {
                "$ref": "#/components/schemas/BenchmarkMetrics"
              },
              "propertyNames": {
                "enum": [
                  "raw_upstream",
                  "clean_rag",
                  "strict_guard"
                ]
              },
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "hidden_css_injection",
                "zero_width_smuggling",
                "comment_and_attr_injection",
                "boilerplate_nav_bloat",
                "complex_span_tables",
                "code_language_fences",
                "tracking_and_malicious_urls",
                "clean_article_preservation"
              ]
            },
            "type": "object",
            "title": "By Category"
          },
          "sample_results": {
            "items": {
              "$ref": "#/components/schemas/BenchmarkSample"
            },
            "type": "array",
            "title": "Sample Results"
          }
        },
        "type": "object",
        "required": [
          "case_count",
          "modes",
          "by_category",
          "sample_results"
        ],
        "title": "BenchmarkResult"
      },
      "BenchmarkSample": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "hidden_css_injection",
              "zero_width_smuggling",
              "comment_and_attr_injection",
              "boilerplate_nav_bloat",
              "complex_span_tables",
              "code_language_fences",
              "tracking_and_malicious_urls",
              "clean_article_preservation"
            ],
            "title": "Category"
          },
          "mode": {
            "type": "string",
            "enum": [
              "raw_upstream",
              "clean_rag",
              "strict_guard"
            ],
            "title": "Mode"
          },
          "injection_blocked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Injection Blocked"
          },
          "content_f1": {
            "type": "number",
            "title": "Content F1"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "table_alignment_valid": {
            "type": "boolean",
            "title": "Table Alignment Valid"
          },
          "code_language_correct": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code Language Correct"
          },
          "elapsed_us": {
            "type": "integer",
            "title": "Elapsed Us"
          },
          "markdown_preview": {
            "type": "string",
            "title": "Markdown Preview"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "category",
          "mode",
          "injection_blocked",
          "content_f1",
          "token_count",
          "table_alignment_valid",
          "code_language_correct",
          "elapsed_us",
          "markdown_preview"
        ],
        "title": "BenchmarkSample"
      },
      "BudgetErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "max_bytes",
              "max_depth",
              "max_nodes"
