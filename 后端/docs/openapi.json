            "default": "strict_guard"
          },
          "strip_hidden": {
            "type": "boolean",
            "title": "Strip Hidden",
            "default": true
          },
          "prune_boilerplate": {
            "type": "boolean",
            "title": "Prune Boilerplate",
            "default": true
          },
          "normalize_tables": {
            "type": "boolean",
            "title": "Normalize Tables",
            "default": true
          },
          "clean_urls": {
            "type": "boolean",
            "title": "Clean Urls",
            "default": true
          },
          "redact_secrets": {
            "type": "boolean",
            "title": "Redact Secrets",
            "default": true
          },
          "infer_code_language": {
            "type": "boolean",
            "title": "Infer Code Language",
            "default": true
          },
          "heading_style": {
            "type": "string",
            "enum": [
              "atx",
              "atx_closed",
              "underlined"
