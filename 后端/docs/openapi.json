          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "observed": {
            "type": "integer",
            "title": "Observed"
          }
        },
        "type": "object",
        "required": [
          "code",
          "limit",
          "observed"
        ],
        "title": "BudgetErrorDetail"
      },
      "BudgetErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/BudgetErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "BudgetErrorResponse"
      },
      "HealthResult": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "uptime_ms": {
            "type": "integer",
            "title": "Uptime Ms"
          },
          "preset_count": {
            "type": "integer",
            "title": "Preset Count"
          },
          "engine_capabilities": {
            "additionalProperties": {
              "type": "boolean"
