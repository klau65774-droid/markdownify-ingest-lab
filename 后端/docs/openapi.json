            "title": "Engine Capabilities"
          }
        },
        "type": "object",
        "required": [
          "version",
          "uptime_ms",
          "preset_count",
          "engine_capabilities"
        ],
        "title": "HealthResult"
      },
      "IngestRequest": {
        "properties": {
          "html": {
            "type": "string",
            "title": "Html"
          },
          "policy": {
            "type": "string",
            "enum": [
              "raw_upstream",
              "clean_rag",
              "strict_guard"
